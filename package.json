{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "preview": "npm run preview --prefix frontend",
    "clean": "npm run clean --prefix frontend && npm run clean --prefix backend",
    "lint": "npm run lint --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build:backend": "npm run build --prefix backend",
    "start:backend": "npm run start --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
